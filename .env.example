# Server API
NEXT_PUBLIC_SERVER_URL=https://chamapay-app.onrender.com

# Google Identity Services (must be a Web application OAuth client)
# Create / edit at: https://console.cloud.google.com/apis/credentials
#
# Under that client, add Authorized JavaScript origins for every host you use, e.g.:
#   http://localhost:3000
#   http://localhost:3002
#   https://YOUR-VERCEL-APP.vercel.app
#
# "Error 401: invalid_client" / "no registered origin" means the current
# browser origin is missing from that list (or the client ID is not a Web client).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
